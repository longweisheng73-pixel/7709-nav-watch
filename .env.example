# Server-side phone alerts are disabled until one channel below is configured.
# The trigger watches theoretical NAV spread only.
# It sends one alert for each crossed level: +/-2%, +/-3%, +/-4%, ...

# Required for remote access to /api/alert/test and /api/preopen-strategy/test.
# ADMIN_TOKEN=replace_with_a_long_random_value

DISCOUNT_ALERT_THRESHOLD_PCT=2
DISCOUNT_ALERT_STEP_PCT=1
DISCOUNT_ALERT_CONFIRM_REFRESHES=2
DISCOUNT_ALERT_CHECK_MS=30000
DISCOUNT_ALERT_COOLDOWN_MS=300000

# Daily pre-open strategy report. Sent once on weekdays within this time window.
PREOPEN_STRATEGY_ENABLED=1
PREOPEN_STRATEGY_TIME=08:55
PREOPEN_STRATEGY_UNTIL=09:20
PREOPEN_STRATEGY_TIMEZONE=Asia/Hong_Kong

# Telegram Bot
# TELEGRAM_BOT_TOKEN=123456789:replace_with_bot_token
# TELEGRAM_CHAT_ID=123456789

# Bark for iPhone
# BARK_DEVICE_KEY=replace_with_bark_key
# BARK_SERVER_URL=https://api.day.app
# Or use a full endpoint:
# BARK_PUSH_URL=https://api.day.app/replace_with_bark_key

# PushPlus
# PUSHPLUS_TOKEN=replace_with_pushplus_token

# ServerChan / Server酱
# SERVERCHAN_SENDKEY=replace_with_sendkey

# Generic webhook receiving JSON POST:
# DISCOUNT_ALERT_WEBHOOK_URL=https://example.com/7709-alert
